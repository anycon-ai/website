---
// 首页架构图：三个盒子加两条线，纯 HTML/CSS，窄屏竖排。
import { dicts, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = dicts[lang].diagram
const boxes = [
  { label: d.machine, lines: d.machineLines },
  { label: d.hub, lines: d.hubLines },
  { label: d.clients, lines: d.clientLines },
]
const arrows = [d.outbound, d.transport]
---

<figure class="rounded-xl border border-border bg-surface p-5 shadow-card">
  <div class="grid grid-cols-1 items-center gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr]">
    {
      boxes.map((b, i) => (
        <>
          <div class="rounded-lg border border-border-strong bg-bg-subtle p-4">
            <div class="mb-2 text-xs font-medium uppercase tracking-wide text-fg-subtle">{b.label}</div>
            <pre class="text-fg">{b.lines.join('\n')}</pre>
          </div>
          {i < arrows.length && (
            <div class="flex flex-col items-center text-xs text-fg-muted md:px-2">
              <span class="mb-1">{arrows[i]}</span>
              <span aria-hidden="true" class="hidden md:inline text-fg-subtle">{i === 0 ? '──────►' : '◄──────'}</span>
              <span aria-hidden="true" class="md:hidden text-fg-subtle">{i === 0 ? '▼' : '▲'}</span>
            </div>
          )}
        </>
      ))
    }
  </div>
  <figcaption class="mt-4 text-center text-xs text-fg-muted">
    <span class="rounded-full border border-border bg-bg-subtle px-3 py-1">🔒 {d.e2e}</span>
  </figcaption>
</figure>
