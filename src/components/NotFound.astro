---
// 404 页内容。两种语言共用，文案按 lang 从字典取。
import { dicts, links, pagePath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = dicts[lang].notFound
---

<section class="mx-auto max-w-5xl px-5 py-24 md:py-32">
  <p class="text-sm font-medium text-accent-text">{t.code}</p>
  <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">{t.heading}</h1>
  <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg-muted">{t.body}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href={pagePath(lang, 'home')} class="rounded-md bg-accent px-5 py-2.5 font-medium text-accent-fg hover:bg-accent-hover">{t.home}</a>
    <a href={links.docs} class="rounded-md border border-border-strong px-5 py-2.5 font-medium hover:bg-bg-subtle">{t.docs}</a>
  </div>
</section>
